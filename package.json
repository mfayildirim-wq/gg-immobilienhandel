{
  "name": "gg-immobilienhandel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "verify": "turbo run typecheck build && turbo run test --concurrency=1",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:generate": "pnpm --filter @gg/db generate",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "umzug": "pnpm --filter @gg/umzug umzug",
    "umzug:probe": "pnpm --filter @gg/umzug umzug --trocken",
    "golden:erzeugen": "tsx werkzeuge/golden-master/erzeugen.ts",
    "paritaet": "playwright test -c playwright.paritaet.config.ts",
    "paritaet:wiederherstellen": "tsx -e \"import('./tests/paritaet/umgebung.ts').then(m => m.wiederherstellen())\"",
    "demo:daten": "tsx werkzeuge/demo-daten.ts",
    "ui:abgleich": "tsx werkzeuge/ui-abgleich.ts"
  },
  "devDependencies": {
    "@gg/domain": "workspace:*",
    "@gg/integrations": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "supabase": "^2.117.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ]
  }
}
