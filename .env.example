# Lokale Entwicklung (Werte aus `pnpm db:status`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
SUPABASE_URL=http://127.0.0.1:55421
# Nur lokal: Login-Prüfung überspringen (wird in Produktion ignoriert)
AUTH_LOCAL_OPEN=1
# Anmeldung im Browser (leer lassen = lokal ohne Anmeldung arbeiten)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Kommagetrennte Liste erlaubter E-Mail-Adressen (Produktion)
AUTH_ALLOWED_EMAILS=
API_PORT=3101
# Dateiablage (Supabase Storage). Lokal: SERVICE_ROLE_KEY aus `pnpm db:status`
SUPABASE_SERVICE_ROLE_KEY=
# KI: Schlüssel eintragen und KI_ATTRAPPE=0 setzen für echte Auswertung.
# KI_ATTRAPPE=1 gewinnt gegen den Schlüssel (liefert Beispieldaten, in der Oberfläche gekennzeichnet)
# — so lässt sich für einen Lauf umschalten, ohne den Schlüssel zu löschen. In Produktion nie aktiv.
ANTHROPIC_API_KEY=
KI_ATTRAPPE=1
# Fremdsysteme ohne echten Zugang ausprobieren (nie in Produktion)
M365_ATTRAPPE=1
# Microsoft-Anmeldung: Adressen, zu denen zurückgeleitet werden darf (kommagetrennt, auch als kopierte URL).
# Lokal gehen localhost und Heimnetz ohne Eintrag; online zählen nur diese Liste und die eigenen Vercel-Domains.
# Jede Adresse muss zusätzlich in Azure AD als Redirect-URI registriert sein: https://<host>/m365/rueckweg
OAUTH_HOSTS=
PROPSTACK_ATTRAPPE=0

# PDF-Export: Pfad zu Chrome/Chromium (leer = Standardorte werden gesucht)
CHROME_PFAD=

# Whisper-Transkription (Anruf aufnehmen im Makler)
OPENAI_API_KEY=

# Verschlüsselt hinterlegte Zugänge (M365, Propstack). Lokal leer lassen: dann entsteht eine Schlüsseldatei.
# In Produktion Pflicht (base64 von 32 Byte: openssl rand -base64 32) — ohne ihn startet die API dort nicht.
GG_ENCRYPTION_KEY=

# Geheimnis der Cron-Routen (/api/cron/sicherung, /api/cron/archiv). Vercel hängt es als „Authorization: Bearer …" an,
# sobald es im Projekt hinterlegt ist. Ohne Wert antworten die Routen immer mit 401 — lokal also einfach leer lassen.
CRON_SECRET=

# Auto-Import-Bot (Angebote → Exposé holen). Lokal an, online AUS, bis hier „ja" steht („nein" schaltet lokal ab).
# Abgeschaltet antworten /api/auto-import/lauf und …/abbrechen mit 503, die Oberfläche zeigt keine Bot-Knöpfe.
AUTO_IMPORT_AKTIV=

# AgentMode (@cosai/kern): nutzt ANTHROPIC_API_KEY; KI_ATTRAPPE=1 schaltet auf die Attrappe. Modell optional überschreiben:
# AGENT_MODELL=claude-sonnet-5
